# Response headers for the Cloudflare deployment (copied into dist/ by Vite).
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Vite output: file names contain a content hash, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and images keep the same file name when replaced, so cache them for 30 days.
/fonts/*
  Cache-Control: public, max-age=2592000
/images/*
  Cache-Control: public, max-age=2592000

# bashies.co.za is the canonical site; keep the *.workers.dev copies out of search results.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
